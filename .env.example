# Kopieren nach ".env" und mit echten Werten fuellen.
# ".env" ist in .gitignore und wird NICHT committed.

ANTHROPIC_API_KEY=sk-ant-...

# Optional, falls step1-feasibility oeffentliche Quellen recherchiert:
# USER_AGENT="PMPlus-Research-Agent/1.0"

# step6-calibration: 1/true = Mock-LLM-Antwort statt echtem Anthropic-Call
# (kein ANTHROPIC_API_KEY/Guthaben noetig, aber KEINE echte unabhaengige
# LLM-Einschaetzung -> tau ist dann nicht aussagekraeftig). Fuer eine echte
# Kalibrierung/Demo auf 0 setzen und einen funktionierenden Key oben eintragen,
# siehe RUNBOOK.md "API-Key-Fallstricke".
MOCK_LLM_RESPONSE=1

# Optional: Simulationszeitraum (step3) bzw. Priorisierungs-Stichtag (step5)
# ueberschreiben. Default reproduziert exakt das committete
# step3-erp-simulation/output_2025/-Datenset (siehe RUNBOOK.md).
# START_DATE=2025-01-01
# WEEKS=53
# AS_OF_DATE=2026-01-01
